# Copy to `.env` (git-ignored) and fill in. Never commit `.env`.
#
# ── PUBLIC (VITE_*) ─────────────────────────────────────────────────────────────
# Vite inlines every VITE_* value into the browser bundle: anyone can read them.
# Put only browser-safe values here (domain-restricted map web keys, public VAPID key).
VITE_USE_MOCKS=0
# Empty = same origin /api/v1 (mock mode / reverse proxy). Production: https://api.<domain>/v1
VITE_API_BASE_URL=
VITE_NESHAN_MAP_KEY=
VITE_BALAD_MAP_KEY=
VITE_DEFAULT_MAP=neshan
# fake | zibal | zarinpal
VITE_PAYMENT_PROVIDER=fake
VITE_WEBPUSH_VAPID_PUBLIC_KEY=
# Forced-update page (GET /app/config minVersion): store/download page for the Android app (https).
# Empty = the button only reloads (enough for the PWA, which updates itself).
VITE_UPDATE_URL=

# ── SECRET (no VITE_ prefix → never reaches the bundle) ─────────────────────────
# These belong to the BACKEND or CI (GitHub Actions secrets). They are listed so the
# secret scanner knows their values and fails the build if one ever appears in code.
ZIBAL_MERCHANT_KEY=CHANGE_ME
ZARINPAL_MERCHANT_ID=CHANGE_ME
SMS_API_KEY=CHANGE_ME
FCM_SERVER_KEY=CHANGE_ME
WEBPUSH_VAPID_PRIVATE_KEY=CHANGE_ME
# Android release signing (CI only)
ANDROID_KEYSTORE_PASSWORD=CHANGE_ME
ANDROID_KEY_ALIAS=CHANGE_ME
ANDROID_KEY_PASSWORD=CHANGE_ME
# base64 of the release .keystore (GitHub secret ANDROID_KEYSTORE_BASE64)
ANDROID_KEYSTORE_BASE64=CHANGE_ME
