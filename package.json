{
  "name": "dokoon-customer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dokoon customer app (PWA + Capacitor Android)",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:gen": "openapi-typescript contract/dokoon-openapi.yaml -o src/api/schema.d.ts",
    "mock:prism": "prism mock contract/dokoon-openapi.yaml -p 4010",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cap:sync": "npm run build:mock && cap sync android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stoplight/prism-cli": "^5.16.0",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
