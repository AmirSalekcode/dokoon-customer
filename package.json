{
  "name": "dokoon-customer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dokoon customer app (PWA + Capacitor Android)",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:panel": "vite --config vite.panel.config.ts",
    "dev:panel:mock": "vite --config vite.panel.config.ts --mode mock",
    "dev:courier": "vite --config vite.courier.config.ts",
    "dev:courier:mock": "vite --config vite.courier.config.ts --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "build:panel": "tsc -b && vite build --config vite.panel.config.ts",
    "build:panel:mock": "tsc -b && vite build --config vite.panel.config.ts --mode mock",
    "build:courier": "tsc -b && vite build --config vite.courier.config.ts",
    "build:courier:mock": "tsc -b && vite build --config vite.courier.config.ts --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:design": "node scripts/design-lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:panel": "playwright test --config playwright.panel.config.ts",
    "e2e:courier": "playwright test --config playwright.courier.config.ts",
    "api:gen": "openapi-typescript contract/dokoon-openapi.yaml -o src/api/schema.d.ts",
    "api:gen:panel": "openapi-typescript restaurant/dokoon-restaurant-openapi.yaml -o src/panel/api/schema.d.ts",
    "api:gen:courier": "openapi-typescript courier/dokoon-courier-openapi.yaml -o src/courier/api/schema.d.ts",
    "mock:prism": "prism mock contract/dokoon-openapi.yaml -p 4010",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cap:sync": "npm run build:mock && cap sync android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "cap:panel:sync": "npm run build:panel:mock && node scripts/panel-android-web.mjs && cd android-panel && cap sync android",
    "android:panel:debug": "npm run cap:panel:sync && node scripts/gradle.mjs android-panel/android assembleDebug",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "secrets:scan:dist": "node scripts/secret-scan.mjs dist",
    "secrets:scan:dist-panel": "node scripts/secret-scan.mjs dist-panel",
    "secrets:scan:dist-courier": "node scripts/secret-scan.mjs dist-courier",
    "preview:perf": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:panel:perf": "vite preview --config vite.panel.config.ts --host 127.0.0.1 --port 4175 --strictPort",
    "preview:courier:perf": "vite preview --config vite.courier.config.ts --host 127.0.0.1 --port 4177 --strictPort",
    "perf:page": "k6 run",
    "perf:load": "k6 run perf/static-load.js",
    "perf:backend:smoke": "k6 run -e PROFILE=smoke perf/backend/restaurant.js",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stoplight/prism-cli": "^5.16.0",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public",
      "public-panel",
      "public-courier"
    ]
  }
}
